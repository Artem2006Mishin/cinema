{
	"name": "movie-seat",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"api": "json-server --watch server/db.json",
		"start": "json-server-auth server/db.json --routes server/routes.json --port 3000",
		"start:prod": "json-server-auth server/db.json --routes server/routes.json --host 0.0.0.0 --port $PORT",
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d dist"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.6.0",
		"gh-pages": "^6.3.0",
		"globals": "^17.7.0",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"json-server": "^0.17.4",
		"json-server-auth": "^2.1.0",
		"navigo": "^8.11.1",
		"tiny-invariant": "^1.3.3"
	}
}
